# Notion integration (server-side, used by /api/*)
NOTION_TOKEN=

# Natural-language parsing via Gemini 2.5 Flash (optional — keyword fallback works without it)
GEMINI_API_KEY=

# Set to "false" to hide the DEMO DATA banner hint (demo data is used automatically
# whenever /api/query fails, e.g. no NOTION_TOKEN)
VITE_DEMO_MODE=true
